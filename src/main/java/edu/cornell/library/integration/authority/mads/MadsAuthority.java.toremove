	// 		"madsrdf:sourceNote",
	// 		"madsrdf:citationNote");
	public static IFetcher fetcher = new IFetcher.HttpFetcher();
	private static final String PADDING = "  ";

	public int setId(int id) {
		this.id.set(id);
		return id;
	}

	public void print(String padding) {
		System.out.println(padding + "id: " + id.get());
		System.out.println(padding + "mainHead start");
		mainHead.print(padding);
		System.out.println(padding + "mainHead end");
		System.out.println(padding + nativeHeading);
		System.out.println(padding + "lccn: " + lccn);
		System.out.println(padding + "catalogId: " + catalogId);
		System.out.println(padding + "source: " + source);
		System.out.println(padding + "undifferentiated: " + undifferentiated);
		if (!sees.isEmpty())
			System.out.println(padding + "Sees:");
		for (MadsRelationship see : sees)
			see.print(padding + PADDING);
		if (!seeAlsos.isEmpty())
			System.out.println(padding + "SeeAlsos:");
		for (MadsRelationship seeAlso : seeAlsos)
			seeAlso.print(padding + PADDING);
		if (!notes.isEmpty())
			System.out.println(padding + "Notes:");
		for (String note : notes)
			System.out.println(padding + PADDING + note);
		if (rda != null && !rda.isBlank())
			System.out.println(padding + "RDA: " + rda);
	}

	public void print() {
		print("");
	}

	/*
	public record HeadingMap(AtomicReference<Integer> id, HeadingMap parent, String heading, String sort, MadsHeadingType headingType,
			int worksBy, int worksAbout, int works, boolean mainEntry, ReferenceType refType,
			String relationship, String reciprocalRelationship, boolean display) {
	 */
	public record MadsHeading(AtomicReference<Integer> id, MadsHeading parent, String heading, String sort, MadsHeadingType headingType) {
		public void print(String padding) {
			if (parent != null) {
				System.out.println(padding + "parent start");
				parent.print(padding + PADDING);
				System.out.println(padding + "parent end");
			}
			System.out.println(padding + "heading: " + heading);
			System.out.println(padding + "sort: " + sort);
			System.out.println(padding + "heading type: " + headingType);
			System.out.println(padding + "----");
		}

		public MadsHeading(MadsHeading parent, String heading, String sort, MadsHeadingType headingType) {
			this(new AtomicReference<>(0), parent, heading, sort, headingType);
		}

		public int setHeadingId(int id) {
			this.id.set(id);
			return id;
		}

		public int headingId() {
			return this.id.get();
		}

		public int parentId() {
			if (parent == null) return 0;
			return parent.headingId();
		}
	}

	public record MadsReference(int id, MadsHeading fromHeading, MadsHeading toHeading, ReferenceType refType, String refDesc) {
		public void print(String padding) {
			System.out.println(padding + "from heading: " + fromHeading.heading);
			System.out.println(padding + "to heading: " + toHeading.heading);
			System.out.println(padding + "ref type: " + refType.toString());
			System.out.println(padding + "ref desc: " + refDesc);
			System.out.println(padding + "----");
		}
	}

	public static List<String> getIdentifiesRWO(JsonObject node) {
		return AuthorityJsonldUtils.asList(node, "madsrdf:identifiesRWO");
	}

	public static List<String> getRelatedAuthority(JsonObject mainEntry) {
		return AuthorityJsonldUtils.asList(mainEntry, "madsrdf:hasRelatedAuthority");
	}

	public static List<String> getVariants(JsonObject mainEntry) {
		return AuthorityJsonldUtils.asList(mainEntry, "madsrdf:hasVariant");
	}

	public static MadsAuthority fromMadsJsonld(Connection authority, String lcId, String source, boolean undifferentiated) throws JsonLdError, SQLException, URISyntaxException, IOException, InterruptedException {
		JsonObject doc = AuthorityJsonldUtils.parseJsonLd(source);
		MadsAuthorityData rec = AuthorityJsonldUtils.parseAuthorityData(doc, lcId);
		System.out.println(rec.source);
		System.out.println("--------------------");
		JsonArray graph = doc.getJsonArray("@graph");
		JsonObject mainEntry = AuthorityJsonldUtils.getJsonObjectForId(graph, lcId);

		if (rec.lccn != null && rec.lccn.startsWith("sj")) {
			System.out.println("Skipping Juvenile subject authority heading: " + lcId);
			return null;
		}

		if (AuthorityJsonldUtils.parseIsSubdivision(mainEntry.get("madsrdf:isMemberOfMADSCollection"))) {
			System.out.println("Skipping subdivision authority heading: " + lcId);
			return null;
		}

		String authLabel = AuthorityJsonldUtils.getAuthorativeLabel(mainEntry);
		MadsHeadingType t = AuthorityJsonldUtils.headingType(mainEntry, lcId);
		MadsHeading mainHead = headingProcess(authority, mainEntry, graph, authLabel, null, t);

		// List<ReferenceMap> references = madsReferencesPopulate(authority, headings);
		// (JsonObject mainEntry, JsonArray graph, String lcId, HeadingMap mainHead)
		List<MadsRelationship> sees = seesPopulate(authority, mainEntry, graph, lcId, mainHead);
		List<MadsRelationship> seeAlsos = seeAlsosPopulate(authority, mainEntry, graph, lcId, mainHead);
		List<String> notes = notesPopulate(authority, mainEntry, graph);

		Rda rda = new Rda();
		Map<String,Collection<String>> data = rda.populateRda(authority, mainEntry, graph);

		String nativeHeading = AuthorityJsonldUtils.getAuthorativeLabel(mainEntry);
		AuthoritySource authSource = AuthorityJsonldUtils.translateAuthoritySource(rec.vocab);
		return new MadsAuthority(new AtomicReference<>(0), mainHead, nativeHeading, rec.lccn, rec.catalogId(), authSource, undifferentiated, sees, seeAlsos, notes, Rda.json(data));
	}

	protected static MadsHeading headingProcess(Connection authority, JsonObject entry, JsonArray graph, String heading, String mainHeading, MadsHeadingType ht) throws SQLException, JsonLdError, IOException, URISyntaxException, InterruptedException {
		// Emulates processHeadingField's parent heading logic for AUTHORTITLE fields:
		// when the heading type is NAME_TITLE, the first component (the name/author part)
		// becomes a parent HeadingMap, mirroring how MARC builds a parent Heading for WORK entries.
		MadsHeading parent = null;
		if (ht == MadsHeadingType.NAME_TITLE) {
			ComponentList componentList = AuthorityJsonldUtils.parseComponentList(entry, graph);
			if (componentList.components.isEmpty()) {
				System.out.println("No components found for NAME_TITLE heading: " + heading);
				return new MadsHeading(null, heading, FilingNormalization.getFilingForm(heading), ht);
			}
			var first = firstComponent(authority, componentList);
			if (first != null) {
				heading = constructHeadingFromComponentList(authority, heading, first, componentList);
				if (first.authorativeLabel != null && first.headingType != null)
					parent = new MadsHeading(null, first.authorativeLabel, FilingNormalization.getFilingForm(first.authorativeLabel), first.headingType);
			}
		}

		heading = prettyHeading(heading);
		heading = acronym(heading, mainHeading);
		return new MadsHeading(parent, heading, FilingNormalization.getFilingForm(heading), ht);
	}

	protected static Component firstComponent(Connection authority, ComponentList componentList) throws SQLException, JsonLdError, IOException, URISyntaxException, InterruptedException {
		if (componentList.components.isEmpty()) return null;

		var first = componentList.first();
		System.out.println("First component: " + first.id + " | " + first.headingType + " | " + first.authorativeLabel);
		if ((first.authorativeLabel == null || first.authorativeLabel.isBlank())
				&& first.id.startsWith("http://id.loc.gov")) {
			var comp = authDataFromLcId(authority, first.id);
			var doc = comp.doc();
			var mainEntry = getJsonObjectForId(doc.getJsonArray("@graph"), first.id);
			var authLabel = comp.auth().authorativeLabel;
			first.authorativeLabel = authLabel;
			first.headingType = parseHeadingType(mainEntry).get(0);
		}
		return first;
	}

	protected static String constructHeadingFromComponentList(Connection authority, String heading, Component first, ComponentList componentList) throws SQLException, JsonLdError, IOException, URISyntaxException, InterruptedException {
		if (first == null) return heading;

		StringBuilder sb = new StringBuilder(first.authorativeLabel);
		List<String> restLabels = new ArrayList<>();
		for (var component : componentList.restComponents()) {
			if (component.authorativeLabel == null || component.authorativeLabel.isBlank()) {
				if (component.id.startsWith("http://id.loc.gov")) {
					var comp = authDataFromLcId(authority, component.id);
					var authLabel = comp.auth().authorativeLabel;
					if (authLabel != null && !authLabel.isBlank())
						restLabels.add(authLabel);
					else
						System.out.println("No label found for component: " + component.id);
				}
				continue;
			}
			restLabels.add(component.authorativeLabel);
		}
		String rest = String.join(" -- ", restLabels);
		if (!rest.isBlank()) sb.append(" | ").append(rest);

		return sb.toString();
	}

	protected static String constructHeadingFromComponentListSimple(String heading, ComponentList componentList) {
		var first = componentList.first();
		if (first == null) return heading;
		if (heading.startsWith(first.authorativeLabel))
			heading = heading.replace(first.authorativeLabel, first.authorativeLabel + " |");
		return heading;
	}

	protected static List<MadsRelationship> seesPopulate(Connection authority, JsonObject mainEntry, JsonArray graph, String lcId, MadsHeading mainHead) throws IOException, InterruptedException, SQLException, JsonLdError, URISyntaxException {
		Set<String> seen = new HashSet<>();
		seen.add(fingerprint(mainHead));
		List<MadsRelationship> sees = new ArrayList<>();

		List<String> variantIds = getVariants(mainEntry);
		List<String> earlierLabels = earlierLabels(graph, mainEntry);
		for (String variantId : variantIds) {
			JsonObject variant = AuthorityJsonldUtils.getJsonObjectForId(graph, variantId);
			if (variant == null || variant.isEmpty()) continue;

			String label = variantLabel(graph, variant);
			if (label == null || label.isBlank()) continue;
			boolean display = !earlierLabels.contains(label);

			MadsHeadingType vt = AuthorityJsonldUtils.headingType(variant, lcId);
			// Relationship rel = relationshipForNode(variant, graph, true);
			MadsHeading varMap = headingProcess(authority, variant, graph, label, mainHead.heading(), vt);
			if (seen.contains(fingerprint(varMap))) continue;
			seen.add(fingerprint(varMap));

			// String relationship, String reciprocalRelationship, HeadingMap heading, boolean display
			MadsRelationship rel = new MadsRelationship(null, null, varMap, display);
			sees.add(rel);
		}
		return sees;
	}

	public static String variantLabel(JsonArray graph, JsonObject node) {
		String label = AuthorityJsonldUtils.getString(node, "madsrdf:variantLabel");
		if (label != null) return label;
		List<String> elementValues = AuthorityJsonldUtils.parseElementList(graph, node);
		return String.join(" ", elementValues);
	}

	public static List<String> earlierLabels(JsonArray graph, JsonObject node) {
		List<String> labels = new ArrayList<>();
		var earler = node.get("madsrdf:hasEarlierEstablishedForm");
		if (earler == null) return labels;
		List<String> earlierIds = AuthorityJsonldUtils.getIdAsList(earler);
		for (String earlierId : earlierIds) {
			JsonObject earlierNode = AuthorityJsonldUtils.getJsonObjectForId(graph, earlierId);
			String label = variantLabel(graph, earlierNode);
			if (label != null && !label.isBlank())
				labels.add(label);
		}
		return labels;
	}

