public record MadsAuthority(AtomicReference<Integer> id, MadsHeading mainHead, String nativeHeading, String lccn, String catalogId, AuthoritySource source, boolean undifferentiated, List<MadsRelationship> sees, List<MadsRelationship> seeAlsos, List<String> notes, String rda) {
