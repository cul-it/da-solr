	public record MadsRelationship(String relationship, String reciprocalRelationship, MadsHeading heading, boolean display) {
		public void print(String padding) {
			System.out.println(padding + "relationship: " + relationship);
			System.out.println(padding + "reciprocal: " + reciprocalRelationship);
			if (heading != null)
				heading.print(padding + PADDING);
			System.out.println(padding + "display: " + display);
			System.out.println(padding + "----");
		}
	}

	public static Map<String, RWO> rwoCache = new HashMap<>();

	public static Map<String, String> RDA_FIELDS = Map.of(
			ASSOCIATED_LOCALE, "Country",
			BIRTH_PLACE, "Birth Place",
			DEATH_PLACE, "Place of Death",
			FIELD_OF_ACTIVITY, "Field",
			HAS_AFFILIATION, "Group/Organization",
			OCCUPATION, "Occupation"
	);
	static final ObjectMapper mapper = new ObjectMapper();
	public static class Rda {
		Map<String, Boolean> recursiveChecker = null;

		public Rda() {
		}

		public Map<String,Collection<String>> populateRda(Connection authority, JsonObject mainEntry, JsonArray graph) throws SQLException, JsonLdError, IOException, URISyntaxException, InterruptedException {
			Map<String,Collection<String>> data = new HashMap<>();
			recursiveChecker = new HashMap<>();
			List<JsonObject> rwos = AuthorityJsonldUtils.getRwos(mainEntry, graph);
			for (JsonObject rwo : rwos) {
				for (String key : RDA_FIELDS.keySet()) {
					JsonValue val = rwo.get(key);
					if (val == null) continue;

					switch (val.getValueType()) {
						case ARRAY, OBJECT -> {
							List<String> ids = AuthorityJsonldUtils.getIdAsList(val);
							for (String id : ids) {
								String value = followRdaNode(authority, graph, id);
								if (value != null)
									add(data, RDA_FIELDS.get(key), value);
							}
						}
						case STRING -> add(data, RDA_FIELDS.get(key), AuthorityJsonldUtils.getString(val));
						default -> {}
					}
				}
			}

			return data;
		}

		public String followRdaNode(Connection authority, JsonArray graph, String blankNodeId) throws SQLException, JsonLdError, IOException, URISyntaxException, InterruptedException {
			if (recursiveChecker.containsKey(blankNodeId))
				// cyclic pointer found, ignore this key
				return null;

			recursiveChecker.put(blankNodeId, true);

			JsonObject obj = AuthorityJsonldUtils.getJsonObjectForId(graph, blankNodeId);
			if (obj.isEmpty())
				if (blankNodeId.startsWith("http://id.loc.gov/rwo/"))
					return rwoLabel(blankNodeId);
				else if (blankNodeId.startsWith("http://id.loc.gov/")) {
					AuthData authData = authDataFromLcId(authority, blankNodeId);
					return authData.auth().authorativeLabel;
				}
				else return null;

			// https://id.loc.gov/authorities/names/n00000203
			// has Occupation "Author" which is not from a URI
			String label = AuthorityJsonldUtils.getString(obj, "rdfs:label");
			if (label != null) return label;

			for (String key : obj.keySet()) {
				if ("@id".equals(key)) continue;
				JsonValue val = obj.get(key);
				if (val.getValueType() == ValueType.OBJECT)
					return followRdaNode(authority, graph, AuthorityJsonldUtils.getString(val.asJsonObject(), "@id"));
			}

			return null;
		}

		public static String rwoLabel(String id) throws IOException, InterruptedException, JsonLdError {
			if (rwoCache.containsKey(id))
				return rwoCache.get(id).label();

			try (InputStream is = fetcher.fetch(id + ".madsrdf.json")) {
				var doc = AuthorityJsonldUtils.parseFlatJsonLd(is, id);
				var rwo = AuthorityJsonldUtils.parseRwo(doc, id);
				rwoCache.put(id, rwo);
				return rwo.label();
			}
		}

		protected void add(Map<String,Collection<String>> data, String field, String value) {
			if ( ! data.containsKey(field))
				data.put(field, new HashSet<>());
			data.get(field).add(value);
		}

		public static String json(Map<String,Collection<String>> data) throws JsonProcessingException {
			if (data.isEmpty()) return null;
			return mapper.writeValueAsString(data);
		}
	}

	public static List<String> valuesFromArray(JsonValue value, JsonArray graph) {
		List<String> values = new ArrayList<>();
		if (value == null) return values;
		switch (value.getValueType()) {
			case STRING -> values.add(AuthorityJsonldUtils.getString(value));
			case OBJECT -> values.addAll(valuesFromObject(value.asJsonObject(), graph));
			case ARRAY -> {
				for (JsonValue v : value.asJsonArray()) {
					values.addAll(valuesFromArray(v, graph));
				}
			}
			default -> {}
		}
		return values;
	}

	public static List<String> valuesFromObject(JsonObject value, JsonArray graph) {
		List<String> values = new ArrayList<>();
		String asValue = AuthorityJsonldUtils.getString(value, "@value");
		if (asValue != null) {
			values.add(asValue);
			return values;
		}

		String id = AuthorityJsonldUtils.getString(value, "@id");
		if (id != null) {
			JsonObject obj = AuthorityJsonldUtils.getJsonObjectForId(graph, id);
			if (!obj.isEmpty()) {
				String label = AuthorityJsonldUtils.getString(obj, "rdfs:label");
				if (label != null) values.add(label);
				String authLabel = AuthorityJsonldUtils.getString(obj, "madsrdf:authoritativeLabel");
				if (authLabel != null) values.add(authLabel);
			}
		}

		String str = AuthorityJsonldUtils.getString(value);
		if (str != null) values.add(str);
		return values;
	}
}
