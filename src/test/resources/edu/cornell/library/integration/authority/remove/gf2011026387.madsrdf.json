            }
        ]
    },
    {
        "@id": "_:b55iddOtlocdOtgovauthoritiesgenreFormsgf2011026387",
        "@type": [
            "http://www.loc.gov/mads/rdf/v1#Source"
        ],
        "http://www.loc.gov/mads/rdf/v1#citationStatus": [
            {
                "@value": "found"
            }
        ],
        "http://www.loc.gov/mads/rdf/v1#citationSource": [
            {
                "@value": "OED online, Dec. 1, 2009:"
            }
        ],
        "http://www.loc.gov/mads/rdf/v1#citationNote": [
            {
                "@language": "en",
                "@value": "map (A drawing or other representation of the earth's surface or a part of it made on a flat surface, showing the distribution of physical or geographical features (and often also including socio-economic, political, agricultural, meteorological, etc., information), with each point in the representation corresponding to an actual geographical position according to a fixed scale or projection; a similar representation of the positions of stars in the sky, the surface of a planet, or the like) physical map [no entry]"
            }
        ]
    },
    {
